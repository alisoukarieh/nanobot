# Auth via browser-extracted cookies (X's login endpoint is Cloudflare-
# blocked, so this is the only stable path). Open https://x.com in your
# browser while logged in, DevTools > Application/Storage > Cookies,
# copy these two values:
#
#   auth_token  — 40-ish hex chars
#   ct0         — ~160 hex chars (CSRF)
#
# Then run: `uv run python set_cookies.py` once to materialise cookies.json.
# After that, fetch_tweets.py reuses cookies.json on every run.

X_AUTH_TOKEN=
X_CT0=

# --- fetch_tweets.py (user timeline) ----------------------------------------

# Which account's tweets to fetch (no @ prefix).
X_TARGET=

# How many tweets to fetch per run.
X_FETCH_LIMIT=40

# --- fetch_community.py (community feed) ------------------------------------

# Numeric community id, or the full https://x.com/i/communities/<id> URL.
X_COMMUNITY_ID=

# Latest | Top | Media. Latest = chronological.
X_COMMUNITY_TWEET_TYPE=Latest

X_COMMUNITY_LIMIT=40
